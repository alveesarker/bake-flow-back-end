# Server
PORT=5000

# MySQL connection (phpMyAdmin / XAMPP / WAMP defaults shown below)
DB_HOST=http://localhost:3000/
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bakeflow

# Comma-separated list of allowed frontend origins for CORS.
# Use * to allow any origin (fine for local development).
CORS_ORIGIN=*
